@model PermissionFormViewModel

<form method="post" class="admin-card admin-form">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="admin-form-grid">
        <label>
            Codigo
            <input asp-for="Code" placeholder="Sistema.Criar" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </label>
        <label>
            Modulo
            <input asp-for="Module" placeholder="Sistemas" />
            <span asp-validation-for="Module" class="text-danger"></span>
        </label>
        <label class="wide">
            Descricao
            <textarea asp-for="Description"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </label>
        <label class="admin-check">
            <input asp-for="IsCritical" />
            Permissao critica
        </label>
        <label class="admin-check">
            <input asp-for="IsActive" />
            Ativa
        </label>
    </div>

    <div class="admin-actions">
        <a asp-action="Index">Cancelar</a>
        <button type="submit">Salvar</button>
    </div>
</form>
