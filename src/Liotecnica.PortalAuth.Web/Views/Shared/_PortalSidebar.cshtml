@using Liotecnica.PortalAuth.Web.Security
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var canViewSystems = (await AuthorizationService.AuthorizeAsync(User, null, PermissionCodes.SystemView)).Succeeded;
    var canManagePermissions = (await AuthorizationService.AuthorizeAsync(User, null, PermissionCodes.PermissionManage)).Succeeded;
    var canManageRoles = (await AuthorizationService.AuthorizeAsync(User, null, PermissionCodes.RoleManage)).Succeeded;
    var canManageUsers = (await AuthorizationService.AuthorizeAsync(User, null, PermissionCodes.UserManage)).Succeeded;
    var canViewAudit = (await AuthorizationService.AuthorizeAsync(User, null, PermissionCodes.AuditView)).Succeeded;

    string Active(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        ? " active"
        : string.Empty;
}

<aside class="portal-sidebar" aria-label="Menu principal">
    <div class="portal-brand">
        <span class="portal-brand__symbol">L</span>
        <span>Portal Corporativo</span>
    </div>

    <nav class="portal-nav">
        <a class="portal-nav__item@(Active("Dashboard"))" asp-controller="Dashboard" asp-action="Index"><span>IN</span>Tela Inicial</a>
        <a class="portal-nav__item@(Active("Account"))" asp-controller="Account" asp-action="Profile"><span>MP</span>Meu Perfil</a>
        <a class="portal-nav__item@(Active("UiKit"))" asp-controller="UiKit" asp-action="Index"><span>UI</span>UI Kit</a>
        <a class="portal-nav__item@(Active("Changelog"))" asp-controller="Changelog" asp-action="Index"><span>CL</span>Changelog</a>
        <a class="portal-nav__item@(Active("Status"))" asp-controller="Status" asp-action="Index"><span>ST</span>Status</a>
        @if (canViewSystems)
        {
            <a class="portal-nav__item@(Active("Systems"))" asp-controller="Systems" asp-action="Index"><span>SI</span>Sistemas</a>
        }
        @if (canManagePermissions)
        {
            <a class="portal-nav__item@(Active("Permissions"))" asp-controller="Permissions" asp-action="Index"><span>PE</span>Permissoes</a>
        }
        @if (canManageRoles)
        {
            <a class="portal-nav__item@(Active("Roles"))" asp-controller="Roles" asp-action="Index"><span>PF</span>Perfis</a>
        }
        @if (canManageUsers)
        {
            <a class="portal-nav__item@(Active("Users"))" asp-controller="Users" asp-action="Index"><span>US</span>Usuarios</a>
        }
        @if (canViewAudit)
        {
            <a class="portal-nav__item@(Active("Audit"))" asp-controller="Audit" asp-action="Index"><span>AU</span>Auditoria</a>
        }
    </nav>

    <button class="portal-collapse" type="button">Recolher menu</button>
</aside>
