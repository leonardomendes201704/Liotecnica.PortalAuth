<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Portal Corporativo</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Liotecnica.PortalAuth.Web.styles.css" asp-append-version="true" />
</head>
<body class="portal-page">
    <div class="portal-shell">
        <partial name="_PortalSidebar" />

        <main class="portal-main">
            <partial name="_PortalTopbar" />

            <section class="portal-content">
                @if (ViewData["Breadcrumbs"] is IReadOnlyCollection<BreadcrumbItemViewModel> breadcrumbs)
                {
                    <partial name="_Breadcrumb" model="breadcrumbs" />
                }
                @RenderBody()
            </section>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
