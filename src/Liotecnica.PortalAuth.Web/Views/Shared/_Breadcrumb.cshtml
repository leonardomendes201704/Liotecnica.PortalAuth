@model IReadOnlyCollection<BreadcrumbItemViewModel>

@if (Model.Count > 0)
{
    <nav class="ui-breadcrumb" aria-label="Breadcrumb">
        @foreach (var item in Model)
        {
            if (item.IsCurrent || string.IsNullOrWhiteSpace(item.Controller) || string.IsNullOrWhiteSpace(item.Action))
            {
                <span aria-current="page">@item.Label</span>
            }
            else
            {
                <a asp-controller="@item.Controller" asp-action="@item.Action">@item.Label</a>
            }
        }
    </nav>
}
