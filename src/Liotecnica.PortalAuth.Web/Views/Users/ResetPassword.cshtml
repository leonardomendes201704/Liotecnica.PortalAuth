@model UserResetPasswordViewModel

@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Redefinir Senha";
}

<div class="admin-header">
    <div>
        <h1>Redefinir Senha</h1>
        <p>Defina uma senha temporaria para o usuario selecionado.</p>
    </div>
</div>

<form method="post" class="admin-card admin-form">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <input asp-for="DisplayName" type="hidden" />
    <input asp-for="Email" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="admin-reset-summary">
        <strong>@Model.DisplayName</strong>
        <span>@Model.Email</span>
    </div>

    <div class="admin-form-grid">
        <label>
            Nova senha temporaria
            <input asp-for="NewPassword" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </label>
        <label>
            Confirmar senha temporaria
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </label>
    </div>

    <p class="admin-help-text">
        A nova senha nao sera registrada em logs ou auditoria. Oriente o usuario a troca-la conforme a politica interna.
    </p>

    <div class="admin-actions">
        <a asp-action="Index">Cancelar</a>
        <button type="submit">Redefinir senha</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
