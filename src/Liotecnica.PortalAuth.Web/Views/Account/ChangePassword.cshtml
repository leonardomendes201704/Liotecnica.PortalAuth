@model ChangePasswordViewModel

@{
    ViewData["Title"] = "Alterar Senha";
    Layout = "_PortalLayout";
    var forcedChange = ViewData["ForcedChange"] as bool? == true;
}

<section class="admin-header">
    <div>
        <p class="admin-kicker">Conta</p>
        <h1>Alterar Senha</h1>
        <p>Defina uma senha forte e diferente da senha temporaria recebida.</p>
    </div>
</section>

@if (forcedChange)
{
    <div class="admin-alert admin-alert--warning">
        A troca de senha e obrigatoria apos reset administrativo.
    </div>
}

<section class="admin-card">
    <form asp-action="ChangePassword" method="post" class="admin-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <label>
            Senha atual
            <input asp-for="CurrentPassword" />
            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
        </label>

        <label>
            Nova senha
            <input asp-for="NewPassword" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </label>

        <label>
            Confirmar nova senha
            <input asp-for="ConfirmPassword" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </label>

        <div class="admin-actions">
            <button class="admin-button" type="submit">Salvar nova senha</button>
            @if (!forcedChange)
            {
                <a class="admin-button admin-button--secondary" asp-action="Profile">Voltar</a>
            }
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
